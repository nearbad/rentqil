# copy to .env and adjust

# postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rentqil
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rentqil

# api
PORT=3001
HOST=0.0.0.0
JWT_SECRET=change-me-long-random-string
TZ=Asia/Tashkent

# public url of the web app, used in split links and payment redirects
WEB_URL=http://localhost:8081
# url the api is reachable at from itself, mock provider posts webhooks here
API_URL=http://localhost:3001

# login codes and reminders go out by email
# mock logs to stdout; resend really sends: sign up at resend.com (free),
# verify the domain (spf + dkim dns records) and paste the api key
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=rentqil <no-reply@rentqil.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=rentqil <no-reply@rentqil.com>

# google oauth for "continue with google", empty hides the button
# create a web client at console.cloud.google.com, authorized redirect uri:
# <API_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# sms is reserved for future booking notifications, auth uses email
SMS_PROVIDER=mock
# echo the otp code in the api response, dev only, never enable in prod
OTP_DEV_ECHO=1
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# mock payment provider webhook signing
MOCK_WEBHOOK_SECRET=mock-secret-change-me

# this email becomes the platform admin on first login, seed also creates it
ADMIN_EMAIL=admin@rentqil.com

# app (expo reads EXPO_PUBLIC_* at build time)
EXPO_PUBLIC_API_URL=http://localhost:3001
# yandex maps js api key from developer.tech.yandex.ru, empty falls back to osm
EXPO_PUBLIC_YANDEX_MAPS_KEY=
# yandex geosuggest http api key for the address autocomplete
EXPO_PUBLIC_YANDEX_SUGGEST_KEY=

# caddy proxy (docker deploy only), serves DOMAIN, www and api subdomains
DOMAIN=rentqil.com
ACME_EMAIL=you@example.com
