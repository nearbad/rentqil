# TLS terminating proxy in front of the stack.
# DOMAIN and ACME_EMAIL are injected by the caddy service from .env.
# Certificates come from Let's Encrypt automatically, first issue needs
# the dns records to already point at this server.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	reverse_proxy web:80
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

api.{$DOMAIN} {
	encode gzip
	reverse_proxy api:3001
}
